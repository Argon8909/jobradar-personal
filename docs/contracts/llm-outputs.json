  "hh_filters": {
    "type": "object",
    "properties": {
      "work_formats": {
        "type": "array",
        "items": {
          "enum": [
            "remote",
            "hybrid",
            "office"
          ]
        }
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
