{
  "search_planner": {
    "type": "object",
    "properties": {
      "search_queries": {
        "type": "object",
        "properties": {
          "version": {
            "const": 1
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "areas": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "filters": {
                  "type": "object",
                  "properties": {
                    "work_formats": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "remote",
                          "hybrid",
                          "office"
                        ]
                      }
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "priority": {
                  "type": "integer"
                }
              },
              "required": [
                "source",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "version",
          "queries"
        ],
        "additionalProperties": false
      },
      "target_count": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1,
        "maximum": 2147483647,
        "description": "Явно запрошенное число вакансий для изучения; null если пользователь не указал."
      }
    },
    "required": [
      "search_queries",
      "target_count"
    ],
    "additionalProperties": false
  },
  "vacancy_analyzer": {
    "type": "object",
    "properties": {
      "card": {
        "type": "object",
        "properties": {
          "profession": {
            "type": [
              "string",
              "null"
            ]
          },
          "specialization": {
            "type": [
              "string",
              "null"
            ]
          },
          "area": {
            "type": [
              "string",
              "null"
            ]
          },
          "work_format": {
            "enum": [
              "remote",
              "hybrid",
              "office",
              "unknown",
              null
            ]
          },
          "salary_from": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "salary_to": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "salary_currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "experience_min": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "structured_data": {
            "type": "object",
            "properties": {
              "version": {
                "const": 1
              },
              "responsibilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "schedule": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "pattern": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "hours_per_shift": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                ]
              },
              "travel": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "required": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "frequency": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                ]
              },
              "employment": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "contract_type": {
                        "enum": [
                          "employment",
                          "contractor",
                          "self_employed",
                          "other",
                          "unknown",
                          null
                        ]
                      },
                      "duration": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                ]
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "additional_facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "value",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "uncertainties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "structured_data"
        ],
        "additionalProperties": false
      },
      "tags": {
        "type": "array",
        "maxItems": 40,
        "items": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "requirement_level": {
              "enum": [
                "required",
                "optional",
                "mentioned"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "category",
            "name",
            "requirement_level",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "assessment": {
        "type": "object",
        "properties": {
          "relevance_score": {
            "type": [
              "number",
              "null"
            ],
            "description": "Необязательная численная оценка, выше — релевантнее; null при отсутствии достоверного значения."
          },
          "decision": {
            "type": "string",
            "description": "Краткий вывод о соответствии, включая неизвестные сведения."
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "decision",
          "reasoning"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "card",
      "tags",
      "assessment"
    ],
    "additionalProperties": false
  },
  "assessment_only": {
    "type": "object",
    "properties": {
