@startuml JobRadar_ERD
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam entity {
  BackgroundColor #FCFCFC
  BorderColor #333333
}

title JobRadar - целевая модель PostgreSQL (проект)

entity "users" as users {
  * id : BIGINT <<PK>>
  --
  name : TEXT
  created_at : TIMESTAMPTZ
}

entity "user_accounts" as accounts {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  * provider : TEXT
  external_user_id : TEXT
  status : TEXT
  linked_at : TIMESTAMPTZ
}

entity "user_profiles" as profiles {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  profile_data : JSONB
  revision : INTEGER
  updated_at : TIMESTAMPTZ
}

entity "search_contexts" as contexts {
  * id : BIGINT <<PK>>
  --
  * profile_id : BIGINT <<FK>>
  title : TEXT
  criteria : JSONB
  criteria_revision : INTEGER
  status : TEXT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "user_sessions" as sessions {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  active_context_id : BIGINT <<FK, NULL>>
  channel : TEXT
  external_chat_id : TEXT
  updated_at : TIMESTAMPTZ
}

entity "messages" as messages {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  * session_id : BIGINT <<FK>>
  context_id : BIGINT <<FK, NULL>>
  role : TEXT
  content : TEXT
  created_at : TIMESTAMPTZ
}

entity "search_tasks" as search_tasks {
  * id : BIGINT <<PK>>
  --
  * context_id : BIGINT <<FK>>
  * goal : TEXT
  * state : TEXT
  search_queries : JSONB
  target_count : INTEGER
  is_partial : BOOLEAN
  stop_reason : TEXT
  created_at : TIMESTAMPTZ
  completed_at : TIMESTAMPTZ
}

entity "task_vacancies" as task_vacancies {
  * task_id : BIGINT <<PK, FK>>
  * vacancy_id : BIGINT <<PK, FK>>
  --
  origin : TEXT
}

entity "vacancies" as vacancies {
  * id : BIGINT <<PK>>
  --
  source : TEXT
  external_id : TEXT
  url : TEXT
  title : TEXT
  employer : TEXT
  description : TEXT
  content_hash : TEXT
  status : TEXT
  published_at : TIMESTAMPTZ
  first_seen_at : TIMESTAMPTZ
  last_seen_at : TIMESTAMPTZ
  last_checked_at : TIMESTAMPTZ
  fetched_at : TIMESTAMPTZ
  --
  UNIQUE(source, external_id)
}

entity "vacancy_cards" as cards {
  * vacancy_id : BIGINT <<PK, FK>>
  --
  profession : TEXT
  specialization : TEXT
  area : TEXT
  work_format : TEXT
  salary_from : NUMERIC
  salary_to : NUMERIC
  salary_currency : TEXT
  experience_min : NUMERIC
  summary : TEXT
  structured_data : JSONB
  source_hash : TEXT
  extraction_version : INTEGER
  extracted_at : TIMESTAMPTZ
}

entity "tags" as tags {
  * id : BIGINT <<PK>>
  --
  category : TEXT
  canonical_name : TEXT
  created_at : TIMESTAMPTZ
  --
  UNIQUE(category, canonical_name)
}

entity "tag_aliases" as ta {
  * id : BIGINT <<PK>>
  --
  * tag_id : BIGINT <<FK>>
  * alias : TEXT
  normalized_alias : TEXT
  created_at : TIMESTAMPTZ
}

entity "vacancy_tags" as vt {
  * vacancy_id : BIGINT <<PK, FK>>
  * tag_id : BIGINT <<PK, FK>>
  --
  requirement_level : TEXT
  evidence : TEXT
}

entity "context_vacancies" as cv {
  * context_id : BIGINT <<PK, FK>>
  * vacancy_id : BIGINT <<PK, FK>>
  --
  relevance_score : NUMERIC
  decision : TEXT
  reasoning : TEXT
  review_status : TEXT
  profile_revision : INTEGER
  criteria_revision : INTEGER
  assessed_at : TIMESTAMPTZ
}

users ||--o{ accounts : has
users ||--o{ profiles : has
users ||--o{ sessions : opens
users ||--o{ messages : writes

profiles ||--o{ contexts : used_by

contexts |o--o{ sessions : active_in
contexts |o--o{ messages : discussed_in
sessions ||--o{ messages : contains

contexts ||--o{ search_tasks : runs
search_tasks ||--o{ task_vacancies : finds
vacancies ||--o{ task_vacancies : present_in
contexts ||--o{ cv : accumulates

vacancies ||--o{ cv : selected
vacancies ||--o| cards : described_by

cards ||--o{ vt : classified
tags ||--o{ vt : assigned
tags ||--o{ ta : has_alias

note right of sessions
  active_context_id = NULL:
  общий диалог JobRadar.

  active_context_id задан:
  работа внутри контекста.
end note

note right of messages
  context_id = NULL:
  сообщение общего диалога.

  context_id задан:
  сообщение поискового контекста.
end note

note right of cv
  Персональная оценка в контексте.
  PK = (context_id, vacancy_id)

  Оценка актуальна, если
  версии профиля и критериев совпадают.
end note

note bottom of search_tasks
  Задание = отдельный запуск поиска.
  state: pending / running / completed
  failed / cancelled

  Связь с найденными вакансиями
  хранится в task_vacancies.
end note

note right of task_vacancies
  PK = (task_id, vacancy_id)
  origin = источник обнаружения;
  независимый состав каждой задачи.
end note

note right of vacancies
  Исходник с полным текстом.
  Никакой LLM-нормализации.
end note

note right of cards
  Создаётся LLM и переиспользуется;
  основные фильтры - в колонках,
  детализация - в structured_data.
end note

note right of ta
  Синонимы канонических тегов.
  LLM решает смысловое совпадение,
  Python проверяет и сохраняет.
  Индекс по normalized_alias;
  Внутри категории alias указывает
  только на один канонический tag;
  неоднозначные имена проверяются.
end note

note right of vt
  FK на vacancy_cards.vacancy_id.
  required / optional / mentioned
  evidence: фрагмент исходника.
end note
@enduml
