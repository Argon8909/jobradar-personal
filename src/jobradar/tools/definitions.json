  {
    "type": "function",
    "function": {
      "name": "create_context",
      "description": "Создать дополнительный поисковый контекст у активного профиля.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Название контекста"
          },
          "criteria": {
            "type": "object",
            "properties": {
              "target_roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "locations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "work_formats": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "remote",
                    "hybrid",
                    "office"
                  ]
                }
              },
              "salary": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "currency": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[A-Z]{3}$"
                      },
                      "strict": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "experience_level": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "preferences": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attribute": {
                      "type": "string",
                      "description": "Имя условия"
                    },
                    "operator": {
                      "type": "string",
                      "description": "Оператор условия"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "attribute",
                    "operator",
                    "value"
                  ]
                }
              },
              "restrictions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attribute": {
                      "type": "string",
                      "description": "Имя условия"
                    },
                    "operator": {
                      "type": "string",
                      "description": "Оператор условия"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "attribute",
                    "operator",
                    "value"
                  ]
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    }
  },
